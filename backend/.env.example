NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/connectly
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ISSUER=connectly-api
JWT_AUDIENCE=connectly-mobile
CLIENT_ORIGIN=http://localhost:8081,http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
SEED_ADMIN_PASSWORD=use-a-unique-development-password
